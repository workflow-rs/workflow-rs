#!/bin/bash
set -e

cargo fmt --all
cargo clippy --workspace --target wasm32-unknown-unknown
cargo clippy --workspace --tests --benches

# wasm-bindgen CLI codegen check.
#
# clippy / cargo-check only run the compiler (proc-macro expansion + type
# checking); they never invoke the wasm-bindgen CLI that post-processes the
# compiled .wasm and generates the JS/TS glue. Some errors only surface in that
# CLI pass -- e.g. two extern types exporting the same JS class name, or a
# `#[wasm_bindgen] impl` on an imported extern type, both of which wasm-bindgen
# >= 0.2.126 rejects. The `tests/wasm32` crate links every workflow-rs crate
# that emits wasm-bindgen bindings into one cdylib, so building it with
# wasm-pack exercises the codegen pass across the whole workspace at once. The
# output is built to a temp dir and discarded.
WP_OUT="$(mktemp -d)"
trap 'rm -rf "$WP_OUT"' EXIT
wasm-pack build tests/wasm32 --dev --target web --out-dir "$WP_OUT"

# wasm-bindgen runtime test for the workflow-wasm `Cast` family. Runs actual
# `#[wasm_bindgen_test]`s under Node.js (requires `node` on PATH), verifying that
# a `#[wasm_bindgen]` + `CastFromJs`/`TryCastFromJs` struct round-trips JS->Rust
# via the `WasmPtr<WasmRefCell<T>>` reference ABI and fails safely on bad input.
wasm-pack test --node tests/wasm32-cast
